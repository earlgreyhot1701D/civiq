# Agenda Watch — copy to .env.local and fill in. .env.local is gitignored.

# Neon Postgres, pgvector enabled. Include ?sslmode=require
DATABASE_URL=

# Anthropic direct API (NOT a gateway — credits live on the Anthropic platform).
# Models used: claude-haiku-4-5-20251001 (rewrite), claude-sonnet-5 (chat).
ANTHROPIC_API_KEY=

# Gemini embeddings, free tier, no credit card. gemini-embedding-2 @ 768-d.
# OPTIONAL: leave blank and search runs lexical-only. It degrades cleanly.
GOOGLE_GENERATIVE_AI_API_KEY=

# Resend. Free tier sends only to your own signup address without a verified domain.
RESEND_API_KEY=
